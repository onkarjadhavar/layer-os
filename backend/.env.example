# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/layer_os
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Application Core
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=generate_a_secure_random_64_character_hex_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI Advisory (Optional - Gemini / FreeLLMAPI)
GEMINI_API_KEY=
FREELLMAPI_BASE_URL=http://localhost:3001/v1

# Razorpay Integration (Optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

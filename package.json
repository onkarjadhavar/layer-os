{
  "name": "layer-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix frontend test",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test:frontend": "npm --prefix frontend test",
    "dev:backend": "cd backend && .venv\\Scripts\\uvicorn app.main:app --reload --port 8000",
    "test:backend": "cd backend && .venv\\Scripts\\pytest",
    "test:all": "npm --prefix frontend test && cd backend && .venv\\Scripts\\pytest"
  }
}

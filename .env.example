# LayerOS Environment Variables
# Copy this file to .env.local

# App Details
NEXT_PUBLIC_APP_NAME="LayerOS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Database & Auth (MANDATORY for Production / Live Farm Mode)
# In production, LayerOS fails fast with a clear error if these are missing.
# To explore without credentials, use the isolated Demo Sandbox mode.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here" # Server-only, NEVER exposed to client

# AI Provider Configuration (Phase 5)
GEMINI_API_KEY=""
AI_PROVIDER="gemini" # 'gemini' | 'rule_based'

# Payment Gateway (Phase 6 - India: Razorpay)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Transactional SMS / WhatsApp Gateway (Phase 6)
MSG91_AUTH_KEY=""
WHATSAPP_BUSINESS_API_TOKEN=""

# Platform Super Admin Configuration
ADMIN_BOOTSTRAP_EMAIL="founder@layeros.in"
ADMIN_SESSION_SECRET="your-strong-random-session-secret"
ADMIN_ALLOWED_IPS="" # Optional comma-separated IP allowlist (e.g. "203.0.113.1,198.51.100.2")
NEXT_PUBLIC_SUPPORT_PHONE="+91 98220 12345"
NEXT_PUBLIC_SUPPORT_WHATSAPP="+91 98220 12345"
